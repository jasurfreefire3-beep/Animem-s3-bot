# ============================================================================
# ANIMEM.UZ - TELEGRAM HLS & MP4 STREAMING BOT SERVER CONFIGURATION
# (Northflank & Low-Resource Server Optimized)
# ============================================================================

# Port va muhit (Northflank avtomatik PORT beradi yoki 3000 o'rnatiladi)
PORT=3000
NODE_ENV=production

# Telegram MTProto & Bot ma'lumotlari
TG_API_ID=6
TG_API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e
TG_STREAM_BOT_TOKEN=8969080492:AAFeXz93y6CjIBv0AmdlfVlE0N53gf_J6gY
TG_STREAM_SESSION=

# Oqim domeni (Northflank bergan *.northflank.app domeni yoki o'zingizning domeningiz)
TG_STREAM_DOMAIN=s3.animem.uz

# Kesh jildi
HLS_CACHE_DIR=./cache

# Ruxsat etilgan domenlar (CORS)
ALLOWED_ORIGINS=https://animem.uz,https://www.animem.uz,http://localhost:5173,http://localhost:3000

# ============================================================================
# KUCHSIZ SERVERLAR (NORTHFLANK MICRO / FREE TIER) OPTIMIZATSIYA SOZLAMALARI
# (Bo'sh qoldirilsa avtomatik eng maqbul parametrlar ishlaydi)
# ============================================================================
# Maksimal RAM chegarasi (MB). Ushbu me'yorga yetganda avtomatik GC va kesh tozalash ishga tushadi:
RAM_LIMIT_MB=220

# Video boshini (moov atom) lahzada ochish uchun saqlanadigan maksimal RAM kesh hajmi (baytlarda, masalan 35MB):
MAX_HEAD_CACHE_BYTES=36700160

# Har bir HTTP so'rovida uzatiladigan maksimal qism (baytlarda, masalan 2.5MB - tarmoq tiqilmasligi uchun):
CHUNK_BURST_SIZE=2621440

# Avtomatik tozalash oraliq vaqti (daqiqa):
CLEANUP_INTERVAL_MIN=15
